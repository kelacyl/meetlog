{
  "name": "meetlog-assistant",
  "version": "1.0.0",
  "description": "本地大模型会议记录助手",
  "main": "dist-electron/main/main.js",
  "author": "MeetLog",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {

    "lucide-react": "^0.460.0",
    "node-llama-cpp": "^3.6.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "javascript-obfuscator": "^5.4.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "terser": "^5.46.2",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.meetlog.assistant",
    "productName": "MeetLog Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/node-llama-cpp/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*"
    ],
    "extraResources": [
      {
        "from": "./assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./tools/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "./tools/whisper",
        "to": "whisper"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "MeetLog",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeetLog Assistant",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
